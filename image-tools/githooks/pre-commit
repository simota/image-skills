#!/bin/sh
# Budgets enforced by a mechanism rather than by remembering.
# Install with: make hooks
#
# The commit is the index, so the index is what gets checked: it is written out
# to a scratch directory and the checks run there. Checking the working tree
# failed clean commits over unrelated unstaged edits, and passed broken staged
# files whose fix happened to sit unstaged beside them.
set -e
# A hooks directory can be shared (a global core.hooksPath), and then this runs
# for every repository on the machine. One that is not this set is not ours to
# judge, and refusing its commits over a missing validator would be.
if ! git cat-file -e :image-tools/validate.py 2>/dev/null \
        && ! git cat-file -e :image-registry/harness.yaml 2>/dev/null; then
    exit 0
fi
tmp=$(mktemp -d)
idx=$(mktemp)
trap 'rm -rf "$tmp" "$idx"' EXIT
trap 'exit 1' INT TERM
# Exported from the tree the commit will record, through an index of its own:
# an intent-to-add entry (`git add -N`) is in the index and not in the commit,
# and the index itself would write it out as an empty file. A fresh index also
# carries no skip-worktree bits, so a sparse checkout exports in full.
GIT_INDEX_FILE="$idx" git read-tree "$(git write-tree)"
GIT_INDEX_FILE="$idx" git checkout-index --all --prefix="$tmp/"
python3 "$tmp/image-tools/validate.py"
python3 "$tmp/image-tools/figures_check.py"
